  },
  {
   "message_key": "finding.fatigue_drift",
   "lang": "hi",
   "mode": "debrief",
   "text": "आपकी रफ़्तार धीमी हो रही है। थोड़ा आराम मदद करेगा।",
   "slots": {},
   "file": "audio/hi/df994a599254584f.mp3"
  },
  {
   "message_key": "finding.fuel_without_work",
   "lang": "en",
