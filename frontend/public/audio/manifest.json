{
 "note": "Generated by scripts/generate_audio.py (make audio). Lookup by message_key + lang + exact text.",
 "voices": {
  "en": "en-IN-PrabhatNeural",
  "hi": "hi-IN-MadhurNeural"
 },
 "entries": [
  {
   "message_key": "shift_hello",
   "lang": "en",
   "mode": "friendly",
   "text": "Hello! I am Saathi, with you on machine EXC001.",
   "file": "audio/en/16b6f27ecd6da55f.mp3"
  },
  {
   "message_key": "shift_hello",
   "lang": "hi",
   "mode": "friendly",
   "text": "नमस्ते! मैं साथी हूँ, मशीन EXC001 पर आपके साथ।",
   "file": "audio/hi/6a58752b6b45f454.mp3"
  },
  {
   "message_key": "greeting",
   "lang": "en",
   "mode": "friendly",
   "text": "Good morning! I am Saathi. We have 3 tasks today.",
   "file": "audio/en/b7e71e001d2ae1ac.mp3"
  },
  {
   "message_key": "greeting",
   "lang": "hi",
   "mode": "friendly",
   "text": "सुप्रभात! मैं साथी हूँ। आज हमारे पास 3 काम हैं।",
   "file": "audio/hi/0a5b33bbe262435a.mp3"
  },
  {
   "message_key": "task_card",
   "lang": "en",
   "mode": "friendly",
   "text": "Task 1: trenching, about 52 minutes.",
   "file": "audio/en/3fcf9d616bd0ffdd.mp3"
  },
  {
   "message_key": "task_card",
   "lang": "hi",
   "mode": "friendly",
   "text": "काम 1: खाई की खुदाई, लगभग 52 मिनट।",
   "file": "audio/hi/35ae90933cdef38b.mp3"
  },
  {
   "message_key": "task_card",
   "lang": "en",
   "mode": "friendly",
   "text": "Task 2: material loading, about 33 minutes.",
   "file": "audio/en/cdb2dcc8cb7fbada.mp3"
  },
  {
   "message_key": "task_card",
   "lang": "hi",
   "mode": "friendly",
   "text": "काम 2: माल की लदाई, लगभग 33 मिनट।",
   "file": "audio/hi/57c31fdc2d127646.mp3"
  },
  {
   "message_key": "task_card",
   "lang": "en",
   "mode": "friendly",
   "text": "Task 3: grading, about 39 minutes.",
   "file": "audio/en/8be669b01b01c6f4.mp3"
  },
  {
   "message_key": "task_card",
   "lang": "hi",
   "mode": "friendly",
   "text": "काम 3: ज़मीन समतल करना, लगभग 39 मिनट।",
   "file": "audio/hi/c5287bd3faba2b4e.mp3"
  },
  {
   "message_key": "rain_today",
   "lang": "en",
   "mode": "friendly",
   "text": "There is light rain this morning.",
   "file": "audio/en/3ef14b3272320b19.mp3"
  },
  {
   "message_key": "rain_today",
   "lang": "hi",
   "mode": "friendly",
   "text": "आज सुबह हल्की बारिश है।",
   "file": "audio/hi/ad41346694ce4638.mp3"
  },
  {
   "message_key": "heat_today",
   "lang": "en",
   "mode": "care",
   "text": "It will get hot today, up to 39 degrees.",
   "file": "audio/en/85788a40e0e595dd.mp3"
  },
  {
   "message_key": "heat_today",
   "lang": "hi",
   "mode": "care",
   "text": "आज गर्मी ज़्यादा होगी, 39 डिग्री तक।",
   "file": "audio/hi/bbb2bfdf07ddefb6.mp3"
  },
  {
   "message_key": "plan_order",
   "lang": "en",
   "mode": "friendly",
   "text": "Suggested order: trenching, material loading and grading.",
   "file": "audio/en/bf85c454257358f9.mp3"
  },
  {
   "message_key": "plan_order",
   "lang": "hi",
   "mode": "friendly",
   "text": "सुझाया गया क्रम: खाई की खुदाई, माल की लदाई और ज़मीन समतल करना।",
   "file": "audio/hi/e5615e0d26c5f6ee.mp3"
  },
  {
   "message_key": "breaks_planned",
   "lang": "en",
   "mode": "friendly",
   "text": "Breaks at 10 and 13 o'clock.",
   "file": "audio/en/c43268fd750295b0.mp3"
  },
  {
   "message_key": "breaks_planned",
   "lang": "hi",
   "mode": "friendly",
   "text": "आराम का समय: 10 और 13 बजे।",
   "file": "audio/hi/a2ad27aaaa75d552.mp3"
  },
  {
   "message_key": "pretask_estimate",
   "lang": "en",
   "mode": "friendly",
   "text": "trenching, light rain. CAT estimate 45 minutes, I expect about 52 minutes.",
   "file": "audio/en/315c91aed683dfc5.mp3"
  },
  {
   "message_key": "pretask_estimate",
   "lang": "hi",
   "mode": "friendly",
   "text": "खाई की खुदाई, हल्की बारिश। CAT का अनुमान 45 मिनट, मेरा अनुमान लगभग 52 मिनट।",
   "file": "audio/hi/57743c15791eb527.mp3"
  },
  {
   "message_key": "warn.rain_slippery",
   "lang": "en",
   "mode": "alert",
   "text": "The ground is slippery after rain. Move slowly and carefully during trenching.",
   "file": "audio/en/c89d4b277bc4b0ce.mp3"
  },
  {
   "message_key": "warn.rain_slippery",
   "lang": "hi",
   "mode": "alert",
   "text": "बारिश से ज़मीन फिसलन भरी है। खाई की खुदाई के समय धीरे और सावधानी से चलें।",
   "file": "audio/hi/89097d208c2e11c9.mp3"
  },
  {
   "message_key": "warn.rain_trench_edge",
   "lang": "en",
   "mode": "alert",
   "text": "Keep the machine at least 2 metres back from the trench edge.",
   "file": "audio/en/aa16dfeda2812a12.mp3"
  },
  {
   "message_key": "warn.rain_trench_edge",
   "lang": "hi",
   "mode": "alert",
   "text": "मशीन को खाई के किनारे से कम से कम 2 मीटर पीछे रखें।",
   "file": "audio/hi/ad8a4183a2d7afd3.mp3"
  },
  {
   "message_key": "lesson_idle_engine_off",
   "lang": "en",
   "mode": "friendly",
   "text": "Quick tip while we wait: if you will idle for more than five minutes, switch the engine off. It saves fuel.",
   "file": "audio/en/5f408bf84c913ce7.mp3"
  },
  {
   "message_key": "lesson_idle_engine_off",
   "lang": "hi",
   "mode": "friendly",
   "text": "रुकते हुए एक छोटी सलाह: अगर पाँच मिनट से ज़्यादा रुकना हो, तो इंजन बंद कर दें। ईंधन बचता है।",
   "file": "audio/hi/0dacf0e623a66282.mp3"
  },
  {
   "message_key": "belt_before_move",
   "lang": "en",
   "mode": "alert",
   "text": "Belt before you move! Fasten your seatbelt.",
   "file": "audio/en/93ef5cfafc99fd4d.mp3"
  },
  {
   "message_key": "belt_before_move",
   "lang": "hi",
   "mode": "alert",
   "text": "चलने से पहले बेल्ट! सीट बेल्ट बाँध लीजिए।",
   "file": "audio/hi/ee1124018c088262.mp3"
  },
  {
   "message_key": "proximity_alert",
   "lang": "en",
   "mode": "alert",
   "text": "Stop! Someone is 2.5 metres from the machine.",
   "file": "audio/en/38bb783449e565ae.mp3"
  },
  {
   "message_key": "proximity_alert",
   "lang": "hi",
   "mode": "alert",
   "text": "रुकिए! मशीन से 2.5 मीटर पर कोई है।",
   "file": "audio/hi/c995383dc3e08760.mp3"
  },
  {
   "message_key": "incident_logged",
   "lang": "en",
   "mode": "friendly",
   "text": "Logged: a person in the work zone. Thank you, the next shift will know.",
   "file": "audio/en/720592172a5e9b6d.mp3"
  },
  {
   "message_key": "incident_logged",
   "lang": "hi",
   "mode": "friendly",
   "text": "दर्ज कर लिया: काम के क्षेत्र में व्यक्ति। धन्यवाद, अगली शिफ्ट को पता रहेगा।",
   "file": "audio/hi/7d806e837750cf5f.mp3"
  },
  {
   "message_key": "debrief_over",
   "lang": "en",
   "mode": "debrief",
   "text": "9 minutes over. About 6 from rain and machine age, about 3 from idle gaps.",
   "file": "audio/en/893d68dbfc5dea17.mp3"
  },
  {
   "message_key": "debrief_over",
   "lang": "hi",
   "mode": "debrief",
   "text": "9 मिनट ज़्यादा लगे। लगभग 6 मिनट बारिश और मशीन की उम्र की वजह से, और लगभग 3 मिनट रुकावटों से।",
   "file": "audio/hi/5f1deee7ee4a6038.mp3"
  },
  {
   "message_key": "debrief_not_your_fault",
   "lang": "en",
   "mode": "debrief",
   "text": "Most of this was not in your hands.",
   "file": "audio/en/59ff358c047803c0.mp3"
  },
  {
   "message_key": "debrief_not_your_fault",
   "lang": "hi",
   "mode": "debrief",
   "text": "इसमें ज़्यादातर आपके हाथ में नहीं था।",
   "file": "audio/hi/53f72e0405f0964b.mp3"
  },
  {
   "message_key": "finding.excessive_idling",
   "lang": "en",
   "mode": "debrief",
   "text": "The machine idled for 30 minutes.",
   "file": "audio/en/9ffc30f8f2f28138.mp3"
  },
  {
   "message_key": "finding.excessive_idling",
   "lang": "hi",
   "mode": "debrief",
   "text": "मशीन 30 मिनट तक खाली चलती रही।",
   "file": "audio/hi/d925c0212ef4bfdd.mp3"
  },
  {
   "message_key": "finding.fuel_without_work",
   "lang": "en",
   "mode": "debrief",
   "text": "1.7 litres of fuel were burned with little or no work done.",
   "file": "audio/en/92d3557420117326.mp3"
  },
  {
   "message_key": "finding.fuel_without_work",
   "lang": "hi",
   "mode": "debrief",
   "text": "बहुत कम या बिना काम के 1.7 लीटर ईंधन खर्च हुआ।",
   "file": "audio/hi/25f6b039109f409a.mp3"
  },
  {
   "message_key": "finding.unbelted_active",
   "lang": "en",
   "mode": "debrief",
   "text": "The seatbelt was off while working for 15 minutes.",
   "file": "audio/en/74c5aacf898309c8.mp3"
  },
  {
   "message_key": "finding.unbelted_active",
   "lang": "hi",
   "mode": "debrief",
   "text": "काम करते समय 15 मिनट तक सीट बेल्ट खुली रही।",
   "file": "audio/hi/2a66c6a8fa4ed367.mp3"
  },
  {
   "message_key": "memory_incident",
   "lang": "en",
   "mode": "alert",
   "text": "Note from the last shift on this machine: a person in the work zone was reported. Stay alert.",
   "file": "audio/en/0ea1be501efa11c3.mp3"
  },
  {
   "message_key": "memory_incident",
   "lang": "hi",
   "mode": "alert",
   "text": "पिछली शिफ्ट का संदेश: इस मशीन पर काम के क्षेत्र में व्यक्ति दर्ज हुआ था। सावधान रहें।",
   "file": "audio/hi/9711b06277df6aef.mp3"
  },
  {
   "message_key": "seatbelt_unfastened",
   "lang": "en",
   "mode": "alert",
   "text": "Your seatbelt is off. Please fasten it.",
   "file": "audio/en/8fbe4111dba4b8cc.mp3"
  },
  {
   "message_key": "seatbelt_unfastened",
   "lang": "hi",
   "mode": "alert",
   "text": "आपकी सीट बेल्ट खुली है। कृपया बाँध लीजिए।",
   "file": "audio/hi/f99e30e1625697e3.mp3"
  },
  {
   "message_key": "safety_alert",
   "lang": "en",
   "mode": "alert",
   "text": "Safety alert. Check all around the machine.",
   "file": "audio/en/0cac345e8dbdd7b9.mp3"
  },
  {
   "message_key": "safety_alert",
   "lang": "hi",
   "mode": "alert",
   "text": "सुरक्षा चेतावनी। मशीन के चारों ओर देख लीजिए।",
   "file": "audio/hi/6d59ae0eff8d2e9a.mp3"
  },
  {
   "message_key": "break_time",
   "lang": "en",
   "mode": "care",
   "text": "Time for a break. Drink some water.",
   "file": "audio/en/dedfc15a1dfacfa8.mp3"
  },
  {
   "message_key": "break_time",
   "lang": "hi",
   "mode": "care",
   "text": "आराम का समय। थोड़ा पानी पी लीजिए।",
   "file": "audio/hi/8f85509678b7a1c2.mp3"
  },
  {
   "message_key": "care_break",
   "lang": "en",
   "mode": "care",
   "text": "You have been working hard. Let us take a ten minute break.",
   "file": "audio/en/1a1daeac7ded751c.mp3"
  },
  {
   "message_key": "care_break",
   "lang": "hi",
   "mode": "care",
   "text": "आप बहुत मेहनत कर रहे हैं। चलिए दस मिनट का आराम करते हैं।",
   "file": "audio/hi/8519735bf18f5d5e.mp3"
  },
  {
   "message_key": "lesson_trench_edge",
   "lang": "en",
   "mode": "friendly",
   "text": "Quick tip: keep the tracks at least one metre back from a trench edge, more when the ground is wet.",
   "file": "audio/en/4ceb64456315b3f3.mp3"
  },
  {
   "message_key": "lesson_trench_edge",
   "lang": "hi",
   "mode": "friendly",
   "text": "छोटी सलाह: खाई के किनारे से पटरियों को कम से कम एक मीटर पीछे रखें, गीली ज़मीन पर और ज़्यादा।",
   "file": "audio/hi/0c58e0d83684d16e.mp3"
  },
  {
   "message_key": "lesson_three_points",
   "lang": "en",
   "mode": "friendly",
   "text": "Quick tip: keep three points of contact when climbing in or out of the cab.",
   "file": "audio/en/03ee3143f04c2821.mp3"
  },
  {
   "message_key": "lesson_three_points",
   "lang": "hi",
   "mode": "friendly",
   "text": "छोटी सलाह: केबिन में चढ़ते और उतरते समय तीन जगह पकड़ बनाए रखें।",
   "file": "audio/hi/18fd47e1b82e7119.mp3"
  },
  {
   "message_key": "lesson_walkaround",
   "lang": "en",
   "mode": "friendly",
   "text": "Quick tip: walk once around the machine before moving. You will see what the seat cannot show you.",
   "file": "audio/en/ca6b0cf893c29bf9.mp3"
  },
  {
   "message_key": "lesson_walkaround",
   "lang": "hi",
   "mode": "friendly",
   "text": "छोटी सलाह: चलने से पहले मशीन का एक चक्कर लगाएँ। जो सीट से नहीं दिखता, वह दिख जाएगा।",
   "file": "audio/hi/5bb220439c53b2e3.mp3"
  },
  {
   "message_key": "lesson_smooth_cycles",
   "lang": "en",
   "mode": "friendly",
   "text": "Quick tip: smooth, full bucket cycles use less fuel than many short, jerky ones.",
   "file": "audio/en/7890a99f097effc6.mp3"
  },
  {
   "message_key": "lesson_smooth_cycles",
   "lang": "hi",
   "mode": "friendly",
   "text": "छोटी सलाह: आराम से भरे हुए बाल्टी चक्र, कई छोटे झटकेदार चक्रों से कम ईंधन खाते हैं।",
   "file": "audio/hi/497d983c75d87a30.mp3"
  },
  {
   "message_key": "lesson_hydration",
   "lang": "en",
   "mode": "friendly",
   "text": "Quick tip: in the heat, drink a glass of water every hour, even if you are not thirsty.",
   "file": "audio/en/a094d23b43c63d08.mp3"
  },
  {
   "message_key": "lesson_hydration",
   "lang": "hi",
   "mode": "friendly",
   "text": "छोटी सलाह: गर्मी में हर घंटे एक गिलास पानी पिएँ, प्यास न लगे तब भी।",
   "file": "audio/hi/555a203727d2569c.mp3"
  },
  {
   "message_key": "debrief_on_time",
   "lang": "en",
   "mode": "debrief",
   "text": "Finished on time. Well done.",
   "file": "audio/en/7c684288a6037077.mp3"
  },
  {
   "message_key": "debrief_on_time",
   "lang": "hi",
   "mode": "debrief",
   "text": "काम समय पर पूरा हुआ। बहुत बढ़िया।",
   "file": "audio/hi/2ca2ff7448e92cd0.mp3"
  },
  {
   "message_key": "finding.fatigue_drift",
   "lang": "en",
   "mode": "care",
   "text": "Your rhythm is slowing down. A short break will help.",
   "file": "audio/en/e938f4530317e95b.mp3"
  },
  {
   "message_key": "finding.fatigue_drift",
   "lang": "hi",
   "mode": "care",
   "text": "आपकी रफ़्तार धीमी हो रही है। थोड़ा आराम मदद करेगा।",
   "file": "audio/hi/e3c58bdd27f1cdae.mp3"
  },
  {
   "message_key": "finding.fatigue_drift_first_shift",
   "lang": "en",
   "mode": "friendly",
   "text": "The pace has slowed compared with earlier in this shift. A short break will help.",
   "file": "audio/en/7f3fabfd814359f7.mp3"
  },
  {
   "message_key": "finding.fatigue_drift_first_shift",
   "lang": "hi",
   "mode": "friendly",
   "text": "इस शिफ्ट में पहले के मुकाबले काम की रफ़्तार कम हुई है। थोड़ा आराम मदद करेगा।",
   "file": "audio/hi/40d09431caf00c8f.mp3"
  },
  {
   "message_key": "cmd_log_incident",
   "lang": "en",
   "mode": "friendly",
   "text": "What happened? Tap a button or tell me.",
   "file": "audio/en/9bf59539146a987f.mp3"
  },
  {
   "message_key": "cmd_log_incident",
   "lang": "hi",
   "mode": "friendly",
   "text": "क्या हुआ? बटन दबाइए या मुझे बताइए।",
   "file": "audio/hi/d07c5112168f099a.mp3"
  },
  {
   "message_key": "cmd_break",
   "lang": "en",
   "mode": "friendly",
   "text": "Okay, take your break. I will be here.",
   "file": "audio/en/e664b24c5e98c8b5.mp3"
  },
  {
   "message_key": "cmd_break",
   "lang": "hi",
   "mode": "friendly",
   "text": "ठीक है, आराम कीजिए। मैं यहीं हूँ।",
   "file": "audio/hi/969502c2ec562ab7.mp3"
  },
  {
   "message_key": "cmd_quiet_on",
   "lang": "en",
   "mode": "friendly",
   "text": "Quiet mode on. I will speak only for safety.",
   "file": "audio/en/53d01a69ea6c3ae8.mp3"
  },
  {
   "message_key": "cmd_quiet_on",
   "lang": "hi",
   "mode": "friendly",
   "text": "शांत मोड चालू। अब मैं सिर्फ़ सुरक्षा के लिए बोलूँगा।",
   "file": "audio/hi/a70c8dff8e88d5b6.mp3"
  },
  {
   "message_key": "cmd_quiet_off",
   "lang": "en",
   "mode": "friendly",
   "text": "Quiet mode off.",
   "file": "audio/en/4337ee32eb4785cd.mp3"
  },
  {
   "message_key": "cmd_quiet_off",
   "lang": "hi",
   "mode": "friendly",
   "text": "शांत मोड बंद।",
