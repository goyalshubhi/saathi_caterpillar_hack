   "file": "audio/en/f4181cf31873b4ff.mp3"
  },
  {
   "message_key": "finding.fuel_without_work",
   "lang": "hi",
   "mode": "debrief",
   "text": "बहुत कम या बिना काम के 1.7 लीटर ईंधन खर्च हुआ।",
   "slots": {
