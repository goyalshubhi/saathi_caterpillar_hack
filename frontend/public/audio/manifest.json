   "file": "audio/en/5fcc11350f5f592e.mp3"
  },
  {
   "message_key": "belt_before_move",
   "lang": "hi",
   "mode": "alert",
   "text": "चलने से पहले बेल्ट! सीट बेल्ट बाँध लीजिए।",
   "slots": {},
   "file": "audio/hi/5642a8d2e263b34f.mp3"
  },
  {
   "message_key": "break_time",
   "lang": "en",
   "mode": "care",
   "text": "Time for a break. Drink some water.",
   "slots": {},
   "file": "audio/en/5b3e73939dcaa0d3.mp3"
  },
  {
   "message_key": "break_time",
   "lang": "hi",
   "mode": "care",
   "text": "आराम का समय। थोड़ा पानी पी लीजिए।",
   "slots": {},
   "file": "audio/hi/97e1366d5ff6c739.mp3"
  },
  {
   "message_key": "breaks_planned",
   "lang": "en",
   "mode": "friendly",
   "text": "Breaks at 10 and 13 o'clock.",
   "slots": {
    "hours": [
     10,
     13
    ]
   },
   "file": "audio/en/871b1c881a555857.mp3"
  },
  {
   "message_key": "breaks_planned",
   "lang": "hi",
   "mode": "friendly",
   "text": "आराम का समय: 10 और 13 बजे।",
   "slots": {
    "hours": [
     10,
     13
    ]
   },
   "file": "audio/hi/de5e76a33ebba4f2.mp3"
  },
  {
   "message_key": "care_break",
   "lang": "en",
   "mode": "care",
   "text": "You have been working hard. Let us take a ten minute break.",
   "slots": {},
   "file": "audio/en/ff1638e0ab7b2346.mp3"
  },
  {
   "message_key": "care_break",
   "lang": "hi",
   "mode": "care",
   "text": "आप बहुत मेहनत कर रहे हैं। चलिए दस मिनट का आराम करते हैं।",
   "slots": {},
   "file": "audio/hi/4342c369aa9553fd.mp3"
  },
  {
   "message_key": "cmd_break",
   "lang": "en",
   "mode": "friendly",
   "text": "Okay, take your break. I will be here.",
   "slots": {},
   "file": "audio/en/a6173fc86a3e889a.mp3"
  },
  {
   "message_key": "cmd_break",
   "lang": "hi",
   "mode": "friendly",
   "text": "ठीक है, आराम कीजिए। मैं यहीं हूँ।",
   "slots": {},
   "file": "audio/hi/e60f0229e8f8e789.mp3"
  },
  {
   "message_key": "cmd_log_incident",
   "lang": "en",
   "mode": "friendly",
   "text": "What happened? Tap a button or tell me.",
   "slots": {},
   "file": "audio/en/49f168e1fcbfe73d.mp3"
  },
  {
   "message_key": "cmd_log_incident",
   "lang": "hi",
   "mode": "friendly",
   "text": "क्या हुआ? बटन दबाइए या मुझे बताइए।",
   "slots": {},
   "file": "audio/hi/471b8064983cf55a.mp3"
  },
  {
   "message_key": "cmd_quiet_off",
   "lang": "en",
   "mode": "friendly",
   "text": "Quiet mode off.",
   "slots": {},
   "file": "audio/en/2f6dd240fcd5e8ac.mp3"
  },
  {
   "message_key": "cmd_quiet_off",
   "lang": "hi",
   "mode": "friendly",
   "text": "शांत मोड बंद।",
   "slots": {},
   "file": "audio/hi/daabc6f5fcf74d0f.mp3"
  },
  {
   "message_key": "cmd_quiet_on",
   "lang": "en",
   "mode": "friendly",
   "text": "Quiet mode on. I will speak only for safety.",
   "slots": {},
   "file": "audio/en/dec81c10bb3585f6.mp3"
  },
  {
   "message_key": "cmd_quiet_on",
   "lang": "hi",
   "mode": "friendly",
   "text": "शांत मोड चालू। अब मैं सिर्फ़ सुरक्षा के लिए बोलूँगा।",
   "slots": {},
   "file": "audio/hi/e0b2a0b642da998d.mp3"
  },
  {
   "message_key": "debrief_not_your_fault",
   "lang": "en",
   "mode": "debrief",
   "text": "Most of this was not in your hands.",
   "slots": {},
   "file": "audio/en/18313e3e8c4ad963.mp3"
  },
  {
   "message_key": "debrief_not_your_fault",
   "lang": "hi",
   "mode": "debrief",
   "text": "इसमें ज़्यादातर आपके हाथ में नहीं था।",
   "slots": {},
   "file": "audio/hi/8b39da0b622016e3.mp3"
  },
  {
   "message_key": "debrief_on_time",
   "lang": "en",
   "mode": "debrief",
   "text": "Finished on time. Well done.",
   "slots": {},
   "file": "audio/en/443f2c89e8c3a777.mp3"
  },
  {
   "message_key": "debrief_on_time",
   "lang": "hi",
   "mode": "debrief",
   "text": "काम समय पर पूरा हुआ। बहुत बढ़िया।",
   "slots": {},
   "file": "audio/hi/5f9148bbdde47141.mp3"
  },
  {
   "message_key": "debrief_over",
   "lang": "en",
   "mode": "debrief",
   "text": "9 minutes over. About 6 from rain and machine age, about 3 from idle gaps.",
